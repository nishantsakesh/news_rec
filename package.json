{
  "name": "newsrec-project",
  "version": "1.0.0",
  "description": "Personalized News Aggregator - Full Stack Application",
  "scripts": {
    "dev:backend": "cd backend && python run.py",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "build:frontend": "cd frontend && npm run build",
    "start:backend": "cd backend && gunicorn 'app:create_app()'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "news",
    "aggregator",
    "recommendations",
    "flask",
    "react",
    "machine-learning",
    "full-stack"
  ],
  "author": "NewsRec Team",
  "license": "MIT"
}